PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://deva-online.onrender.com
JWT_SECRET=CHANGE_TO_A_CRYPTOGRAPHICALLY_RANDOM_64_BYTE_SECRET
ADMIN_EMAIL=admin@devafurniture.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_VERY_STRONG_PASSWORD_1!

# FIB PAYMENT
# sandbox: use the stage URL below. production: use the LIVE base URL and credentials provided by FIB.
FIB_MODE=production
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
FIB_BASE_URL=REPLACE_WITH_FIB_LIVE_BASE_URL
FIB_CALLBACK_SECRET=CHANGE_TO_ANOTHER_LONG_RANDOM_SECRET
IQD_PER_USD=1310

ALLOWED_ORIGINS=https://deva-online.onrender.com
TRUST_PROXY=true
ALLOW_BEARER_AUTH=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
SECURITY_ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANALYTICS_SALT=CHANGE_TO_A_LONG_RANDOM_ANALYTICS_SALT
REWARDS_QR_TOKEN=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATA_DIR=/var/data
DB_PATH=/var/data/deva.sqlite
UPLOAD_DIR=/var/data/uploads/products
BACKUP_DIR=/var/data/backups
RESET_ADMIN_ONCE_TOKEN=

# Push credentials are configured through Expo EAS credentials:
# Android: FCM V1 / google-services.json
# iOS: APNs key/certificate via Apple Developer / EAS
# Do NOT commit real credential files to GitHub.
EAS_PROJECT_ID=
