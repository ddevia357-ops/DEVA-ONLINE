PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://YOUR-DOMAIN.example
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_TO_A_CRYPTOGRAPHICALLY_RANDOM_64_BYTE_SECRET
ADMIN_EMAIL=admin@devafurniture.com
# 14+ chars: uppercase, lowercase, number and symbol
ADMIN_PASSWORD=CHANGE_THIS_TO_A_VERY_STRONG_PASSWORD_1!
FIB_MODE=sandbox
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
FIB_BASE_URL=https://fib.stage.fib.iq
# Send this in X-FIB-Callback-Secret header, never in URL
FIB_CALLBACK_SECRET=CHANGE_TO_ANOTHER_LONG_RANDOM_SECRET
IQD_PER_USD=1310
ALLOWED_ORIGINS=https://YOUR-DOMAIN.example
TRUST_PROXY=true
ALLOW_BEARER_AUTH=false

# Professional security options
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
# Optional future integrations
SECURITY_ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Analytics stores only a hashed IP, not the raw IP. Set a separate random salt in production.
ANALYTICS_SALT=CHANGE_TO_A_LONG_RANDOM_ANALYTICS_SALT

# DEVA Rewards Club
REWARDS_QR_TOKEN=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# PUBLIC_BASE_URL=https://your-domain.example

# Persistent storage for online hosting (mount a persistent volume here)
DATA_DIR=/var/data
DB_PATH=/var/data/deva.sqlite
UPLOAD_DIR=/var/data/uploads/products
BACKUP_DIR=/var/data/backups
